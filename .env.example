# Legal Document Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=legal-document-assistant
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server
HOST=0.0.0.0
PORT=8000

# =============================================================================
# LLM Configuration (Open Source Options)
# =============================================================================

# Option 1: Ollama (Recommended - fully local/open source)
# Install: https://ollama.ai
# Models: llama4, mistral, codellama, etc.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama4

# Option 2: OpenAI-compatible API (for cloud deployments)
# OPENAI_API_KEY=  # Set in environment, not here
# OPENAI_MODEL=gpt-4o

# =============================================================================
# Vector Store (Open Source)
# =============================================================================

# ChromaDB (local, open source)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Collection names for legal RAG
CHROMA_CONTRACTS_COLLECTION=contracts
CHROMA_CASE_LAW_COLLECTION=case_law
CHROMA_CLAUSES_COLLECTION=approved_clauses

# =============================================================================
# Database (Open Source)
# =============================================================================

# SQLite (for development)
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/legal_docs.db

# PostgreSQL for production (open source)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/legal_docs

# =============================================================================
# OCR Configuration (Open Source)
# =============================================================================

# Tesseract OCR (open source)
TESSERACT_CMD=/usr/local/bin/tesseract

# OCR Language(s)
OCR_LANGUAGES=eng

# =============================================================================
# Document Processing
# =============================================================================

# Upload directory for documents
UPLOAD_DIRECTORY=./data/uploads

# Maximum file size (in MB)
MAX_FILE_SIZE_MB=50

# Supported formats
SUPPORTED_FORMATS=pdf,docx,doc,txt,png,jpg,jpeg

# =============================================================================
# Security & Compliance
# =============================================================================

# Encryption key for documents at rest (generate with: openssl rand -hex 32)
# ENCRYPTION_KEY=  # Set in environment, not here

# PII Detection enabled
PII_DETECTION_ENABLED=true

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./data/audit/audit.log

# =============================================================================
# Cache (Open Source - Optional)
# =============================================================================

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# spaCy NLP Model
# =============================================================================

# spaCy model for NLP (open source)
# Install: python -m spacy download en_core_web_lg
SPACY_MODEL=en_core_web_lg
